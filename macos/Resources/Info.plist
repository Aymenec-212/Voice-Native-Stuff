<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Voice-Native Research</string>
    <key>CFBundleDisplayName</key>
    <string>Voice-Native Research</string>

    <!-- TCC keys microphone permission by bundle id. Keep this stable, or every build
         looks like a new app and re-prompts. -->
    <key>CFBundleIdentifier</key>
    <string>com.aymenec.voicenativeresearch</string>

    <key>CFBundleExecutable</key>
    <string>__EXECUTABLE__</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Without this key, requesting microphone access does not fail — macOS terminates
         the process. It is the whole reason a bare SwiftPM binary cannot be used. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Voice-Native Research transcribes your speech on this Mac. Audio never leaves the machine — only the text you approve is sent to the research service.</string>

    <!-- A menu-bar utility: no Dock icon, no main window. -->
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
