# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# --- Tavily ---
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Agent budgets (see docs/PLAN.md §11) ---
RESEARCH_MAX_TURNS=6
RESEARCH_MAX_SEARCHES=4
RESEARCH_MAX_RESULTS_PER_SEARCH=5
RESEARCH_MAX_ADVANCED_SEARCHES=1
RESEARCH_DEFAULT_DEPTH=basic
RESEARCH_ALLOW_ADVANCED=true
RESEARCH_DECISION_MAX_TOKENS=1024
RESEARCH_ANSWER_MAX_TOKENS=2048
# Additional synthesis token allowance for models that reason before answering.
RESEARCH_REASONING_MAX_TOKENS=4096
RESEARCH_REQUEST_TIMEOUT_S=90

# --- ASR (Milestone 1) — see docs/milestone-1-asr.md ---
# Engine adapter: mlx (Apple Silicon, in-process) | moshicpp (subprocess) | mock
# "mock" invents text and is never a fallback for a broken runtime.
VNR_ASR_ENGINE=mlx
# Keep weights warm between recordings; release after this many idle seconds.
VNR_ASR_IDLE_TIMEOUT_S=300
# Reusable Metal scratch cache only; weights and attention context are unaffected.
VNR_ASR_CACHE_LIMIT_MB=128

# --- MLX engine (the chosen runtime) ---
# Fetched on first run and cached. config.json in the repo names the Mimi weights,
# the LM weights and the tokenizer, so no filename is guessed.
VNR_ASR_HF_REPO=kyutai/stt-1b-en_fr-mlx
# Quantize the bf16 checkpoint in memory AFTER loading it: 4 or 8, or unset for bf16.
# Start at 8 — 4-bit is documented as corrupting the TTS model and is untested for STT.
VNR_ASR_QUANT_BITS=8
# A *.q4/*.q8 checkpoint is quantized ON DISK and is quantized BEFORE loading instead;
# the bit width comes from the filename and overrides VNR_ASR_QUANT_BITS. Note that
# kyutai/stt-1b-en_fr-mlx publishes no such file today — it is bf16 only.
# VNR_ASR_WEIGHTS_NAME=model.q8.safetensors
# Use a local directory instead of the Hub (must contain config.json + the files it names).
# VNR_ASR_MODEL_DIR=
VNR_ASR_MAX_STEPS=4096

# --- Audio framing (both engines) ---
# 1920 samples of 24 kHz mono = 80 ms, which is exactly what Kyutai steps on.
VNR_ASR_SAMPLE_RATE=24000
VNR_ASR_FRAME_MS=80
# PCM wire format between UI and service: s16le (default, half the bandwidth) | f32le
VNR_ASR_STDIN_FORMAT=s16le
# Silence after the last output before an utterance is final. Kyutai decodes ~0.5s behind.
VNR_ASR_FINALIZE_GRACE_MS=800
# How long finalize tolerates NO PROGRESS before giving up. This is a stall detector, not
# a total budget: replaying a file faster than real time queues the whole recording, and
# that backlog may legitimately take minutes to drain.
VNR_ASR_FINALIZE_TIMEOUT_S=10

# --- moshicpp engine (rejected for macOS; kept for Linux/CUDA hosts) ---
# VNR_ASR_BINARY=
# VNR_ASR_MODEL_DIR=models/stt-q4k
# VNR_ASR_QUANT=q4_k
# argv template. Placeholders: {binary} {model_dir} {model} {quant} {sample_rate}
# VNR_ASR_COMMAND={binary} -r {model_dir} -q {quant} -i -
# VNR_ASR_OUTPUT_FORMAT=text
# VNR_ASR_READY_MARKER=

# --- Local service (Milestone 3+) ---
VNR_SERVICE_HOST=127.0.0.1
VNR_SERVICE_PORT=8765
